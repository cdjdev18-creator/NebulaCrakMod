{
  "schemaVersion": 1,
  "id": "nebulacrakmod",
  "version": "${version}",
  "name": "NebulaCrakMod",
  "description": "A Meteor Client addon with custom features, commands, and translation support.",
  "authors": ["NebulaCrak"],
  "contact": {
    "homepage": "https://github.com/NebulaCrak/NebulaCrakMod",
    "sources": "https://github.com/NebulaCrak/NebulaCrakMod",
    "issues": "https://github.com/NebulaCrak/NebulaCrakMod/issues"
  },
  "license": "MIT",
  "icon": "assets/nebulacrakmod/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.nebulacrak.NebulaCrakMod"
    ]
  },
  "mixins": [
    "nebulacrakmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "meteor-client": "*"
  },
  "custom": {
    "meteor-client:color": "8B5CF6"
  }
}